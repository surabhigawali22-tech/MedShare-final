# MedShare Client Environment Configuration
# For local browser development, leave empty to use Vite proxy (/api -> http://localhost:5000)
# For mobile APK testing on the same Wi-Fi, set to your computer's local IP:
# VITE_API_BASE_URL=http://192.168.1.8:5000
# For production deployment, set to your live domain:
# VITE_API_BASE_URL=https://api.medshare.org
VITE_API_BASE_URL=
